# Operand-wise route: MXFP4-v4 for fprop and Wgrad, localCTA-v4 for dgrad,
# paired plain H16 (identity signs) on Wgrad X/dY, and row data-SR on dgrad.
source "$(dirname "${BASH_SOURCE[0]}")/mxfp4_v4_row_sr.env"
export MXFP4_USE_LOCALCTA_DGRAD='1'
export USE_TK_LOCALCTA='0'
export USE_TK_LOCALCTA_VARIANT='v4'
export MXFP4_USE_RHT='1'
export MXFP4_RHT_TE_STYLE='1'
export MXFP4_RHT_ACTIVATION='1'
export MXFP4_RHT_GRAD='1'
export MXFP4_RHT_WEIGHT='0'
export MXFP4_RHT_AXES='col'
export MXFP4_RHT_BLOCK_SIZE='16'
export MXFP4_RHT_RANDOM_SIGN_MASK='0'
