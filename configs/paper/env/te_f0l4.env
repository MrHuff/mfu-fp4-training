# Transformer Engine NVFP4 on blocks 1-28; blocks 29-32 and the output head
# remain BF16. [te_fp4].exclude_last_n_layers in the route manifest is the
# converter-facing half of this contract.
export USE_FP4_CONVERT_OUTPUT_HEAD='0'
export FP4_KEEP_LAST_N_LAYERS_BF16='4'
export FP4_KEEP_LAST_N_FFNS_BF16='4'
export NVTE_NVFP4_DISABLE_RHT='0'
export NVTE_NVFP4_DISABLE_STOCHASTIC_ROUNDING='0'
export NVTE_NVFP4_DISABLE_2D_QUANTIZATION='0'
export NVTE_NVFP4_ENCODE_CENTRIC='0'
export LBT_REQUIRE_FRESH_START='1'
