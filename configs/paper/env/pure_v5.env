# All-32-layer native-v5 body used by the long paper recipe. The output
# projection is ordinary BF16 nn.Linear and the loss is regular cross entropy
# compiled by torch.compile. No launch platform or experiment identity lives
# in this file.
export PYTORCH_CUDA_ALLOC_CONF='expandable_segments:True'
export PYTORCH_ALLOC_CONF='expandable_segments:True'
export TORCHTITAN_FSDP_EXPLICIT_PREFETCH='1'
export TORCHTITAN_FSDP_PREFETCH_DEPTH='1'
export USE_FP4_CONVERT_OUTPUT_HEAD='0'
export FP4_KEEP_LAST_N_LAYERS_BF16='0'
