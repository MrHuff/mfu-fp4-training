export FP4_KEEP_LAST_N_LINEAR_LAYERS_BF16='0'
export LBT_NEMOTRON_H_FP4_OUTPUT_HEAD='0'
export LBT_LOCALCTA_V4_PROFILE='off'
export USE_TK_LOCALCTA='0'
export USE_TK_LOCALCTA_FUSED='0'
export USE_FP4_CODA_EXACT_CDE='0'
export USE_FP4_CODA_EXACT_CDE_WO='0'
export FP4_ATTN_BACKEND='tk'
export FP4_FFN_BACKEND='tk'
export USE_TK_GEMM='1'
