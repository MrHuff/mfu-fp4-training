# Begin with the complete row-SR MXFP4-v4 production route.
source "$(dirname "${BASH_SOURCE[0]}")/mxfp4_v4_row_sr.env"

# Paired, fixed-sign, normalized H32 is applied only to the activation and dY
# column carriers consumed by Wgrad. Fprop, dgrad, and stored weights are not
# rotated. The historical variable name RANDOM_SIGN_MASK is ABI terminology:
# value 1 selects the deterministic 0x2817 H16 motif repeated in both halves.
export MXFP4_USE_RHT='1'
export MXFP4_RHT_TE_STYLE='1'
export MXFP4_RHT_ACTIVATION='1'
export MXFP4_RHT_GRAD='1'
export MXFP4_RHT_WEIGHT='0'
export MXFP4_RHT_AXES='col'
export MXFP4_RHT_BLOCK_SIZE='32'
export MXFP4_RHT_RANDOM_SIGN_MASK='1'
export MXFP4_USE_FUSED_SILU_FFN_QUANT_RHT='1'
