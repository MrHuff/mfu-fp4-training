# Begin with the complete row-SR localCTA-v4 production route.
source "$(dirname "${BASH_SOURCE[0]}")/localcta_v4_row_sr.env"

# Paired fixed-sign H16 is applied to the X and dY column carriers used by
# Wgrad. Weights remain untransformed. RANDOM_SIGNS is a retained historical
# ABI name; the released runtime uses the deterministic 0x2817 sign diagonal.
export USE_TK_LOCALCTA_PAIRED_RHT_CARRIER='1'
export USE_FP4_CODA_EXACT_CDE='0'
export USE_FP4_CODA_EXACT_CDE_WO='0'
export NVFP4_USE_RHT='1'
export NVFP4_RHT_ACTIVATION='1'
export NVFP4_RHT_GRAD='1'
export NVFP4_RHT_WEIGHT='0'
export NVFP4_RHT_AXES='col'
export NVFP4_RHT_RANDOM_SIGNS='1'
